<%# JD Pools: shown above the upload box while a sender has no documents yet (upstream only offers its tour once a template exists). %>
<% l = Jdpools.locale_for(cookies) %>
<% if params[:tour] == 'true' %>
  <%# Upstream renders the tour only inside the template grid, so an empty dashboard needs its own. %>
  <div class="hidden md:block">
    <app-tour data-show-tour="true" data-type="dashboard" data-next-page-path="<%= can?(:manage, current_account) ? settings_account_path : jdpools_guide_path %>" data-i18n="<%= t('app_tour', locale: l).to_json %>"></app-tour>
  </div>
<% end %>
<div class="rounded-box border border-base-300 bg-white p-6 md:p-8 mb-6" lang="<%= l %>">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= t('jdp_welcome_title', locale: l) %></h2>
      <p class="mt-1 opacity-70"><%= t('jdp_first_steps.lede', locale: l) %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t('jdp_first_steps.tour', locale: l), root_path(tour: true), class: 'btn btn-sm btn-outline' %>
      <%= link_to t('jdp_first_steps.guide', locale: l), jdpools_guide_path, class: 'btn btn-sm btn-neutral' %>
    </div>
  </div>
  <ol class="grid gap-4 md:grid-cols-3 mt-6">
    <% Array.wrap(t('jdp_first_steps.steps', locale: l)).each_with_index do |step, i| %>
      <li class="flex gap-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-neutral text-neutral-content text-sm shrink-0"><%= i + 1 %></span>
        <div>
          <div class="font-semibold"><%= step[:title] %></div>
          <div class="text-sm opacity-70 mt-0.5"><%= step[:body] %></div>
        </div>
      </li>
    <% end %>
  </ol>
</div>
