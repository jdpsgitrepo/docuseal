<%# JD Pools: brand logo in place of the DocuSeal mark. "Powered by DocuSeal" attribution stays in shared/_powered_by. %>
<%# Callers pass height as 37 or '50px'; strip any unit so the style never reads "50pxpx" (a 600px logo on phones). %>
<img src="/jdpools-logo.png" alt="J.D. Pools" class="<%= local_assigns[:class] %>" style="height: <%= local_assigns.fetch(:height, '37').to_s.delete_suffix('px') %>px; width: auto; max-width: 100%;">
